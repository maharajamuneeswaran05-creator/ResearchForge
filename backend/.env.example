# Copy this file to backend/.env and fill in your keys.
# Never commit .env - it is gitignored.

NEBIUS_API_KEY=your_nvidia_or_nebius_api_key_here
NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
REQUEST_TIMEOUT_SECONDS=60

# Tavily Search (evidence collection)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_MAX_RESULTS=5

# --- Nebius AI Cloud: Serverless AI (experiment execution) ---
# NEBIUS_API_KEY must be a Nebius AI Cloud access token (not the NVIDIA nvapi- key).
NEBIUS_PROJECT_ID=your_nebius_project_id
NEBIUS_SERVERLESS_BASE_URL=https://api.nebius.cloud
NEBIUS_JOB_IMAGE=python:3.12-slim
# Optional: platform / preset / subnet of the Serverless AI job
NEBIUS_JOB_PLATFORM=
NEBIUS_JOB_PRESET=
NEBIUS_JOB_SUBNET_ID=
NEBIUS_JOB_DISK_SIZE_BYTES=21474836480

# --- Nebius AI Cloud: Object Storage (experiment results) ---
# Static credentials of a service account with write access to the bucket.
NEBIUS_RESULTS_BUCKET=your_results_bucket
NEBIUS_STORAGE_ACCESS_KEY_ID=your_storage_access_key_id
NEBIUS_STORAGE_SECRET_KEY=your_storage_secret_key
NEBIUS_STORAGE_REGION=your_storage_region

# --- Experiment execution ---
EXPERIMENT_TIMEOUT_SECONDS=900
EXPERIMENT_POLL_INTERVAL_SECONDS=5

# Optional: set to 'true' to allow simulated demo execution when Nebius Cloud
# infrastructure is unconfigured. Demo executions are clearly labeled with
# [DEMO MODE] banners and cannot be confused with real cloud measurements.
EXPERIMENT_DEMO_MODE=false
